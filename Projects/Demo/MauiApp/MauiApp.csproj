<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import common definitions -->
	<Import Project="../../Localization.Import.csproj" />

	<PropertyGroup>

		<RootNamespace>Armat.Localization.Demo</RootNamespace>
		<AssemblyName>armat.localization.demo.maui</AssemblyName>

		<OutputType>Exe</OutputType>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<TargetFrameworks>$(_DotNetVersion)-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);$(_DotNetVersion)-ios;$(_DotNetVersion)-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(_DotNetVersion)-windows10.0.19041.0</TargetFrameworks>

		<OutputPath>..\..\..\bin\$(Configuration)\Maui\$(TargetFramework)</OutputPath>
		<IntermediateOutputPath>..\..\..\bin\$(Configuration)\obj\Maui\$(TargetFramework)\$(AssemblyName)</IntermediateOutputPath>

		<!-- Note for MacCatalyst:
		The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
		When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
		The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
		either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>MauiApp</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.armat.mauiapp</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>$(_ArmatLocalizationVersion)</ApplicationDisplayVersion>
		<ApplicationVersion>2</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Suppress per-locale subdirectories (cs/, de/, es/, ja/, ...) in the output. These are
		     Microsoft.Maui.Controls.resources.dll satellites for the framework's own UI strings
		     and are unrelated to this project's Localization/<locale>/ translation files.
		     `en` is the neutral resources language and is embedded in the main assembly, so this
		     effectively produces no satellite folders. -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Pin TargetPlatformVersion so the published NuGet package's lib folders are deterministic
		     (e.g. lib/net10.0-ios26.0/) instead of inheriting whatever platform SDK the packing
		     machine happens to have installed at pack time. Without these pins, an SDK upgrade on
		     the packer's machine silently ratchets the package's lib folders to a newer version
		     and locks out every consumer that hasn't installed the matching SDK
		     (NU1202: package supports net10.0-iosXX.X, consumer is on net10.0-iosYY.Y, YY < XX).
		     Lower these to broaden consumer compatibility once the matching workload manifests
		     are installed via `dotnet workload install` with an explicit older version. -->
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">26.0</TargetPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">26.0</TargetPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</TargetPlatformVersion>

	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />
		<MauiImage Update="Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.7" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

		<PackageReference Condition="'$(Configuration)' != 'Debug'" Include="armat.localization.core" Version="$(_ArmatLocalizationVersion)$(_NugetVersionPostfix)" />
		<ProjectReference Condition="'$(Configuration)' == 'Debug'" Include="..\..\Localization.Core\Localization.Core.csproj" />

		<PackageReference Condition="'$(Configuration)' != 'Debug'" Include="armat.localization.maui" Version="$(_ArmatLocalizationVersion)$(_NugetVersionPostfix)" />
		<ProjectReference Condition="'$(Configuration)' == 'Debug'" Include="..\..\Localization.Maui\Localization.Maui.csproj" />
		
	</ItemGroup>

	<ItemGroup>
		<None Update="Localization\**\*.trd">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			<TargetPath>%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
		</None>
		<MauiAsset Include="Localization\**\*.trd" LogicalName="Localization\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Localization\NestedRD\OtherTexts.xaml.cs">
			<DependentUpon>OtherTexts.xaml</DependentUpon>
		</Compile>
		<Compile Update="Localization\StringTable.xaml.cs">
			<DependentUpon>StringTable.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<MauiXaml Update="Localization\NestedRD\OtherTexts.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Localization\StringTable.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>

	<!-- Microsoft.WinUI ships per-language *.dll.mui resource bundles for its built-in controls
	     in dozens of locale subdirectories (af-ZA, am-ET, ar-SA, ..., zh-HK, zh-TW). The Windows
	     TFM build output ends up with one folder per language. SatelliteResourceLanguages doesn't
	     filter these — they're native MUI resources, not managed satellite assemblies — and the
	     WindowsAppSDK pipeline copies them through item lists that are consumed/cleared before
	     any user-defined Target can intercept them. The pragmatic fix is a post-build cleanup:
	     enumerate the output directory, identify subdirs whose names match the IETF language-tag
	     shape (e.g. xx, xx-YY, xx-Yyyy-ZZ), exclude en-*, and delete them. The "Localization",
	     "Microsoft.UI.Xaml", "NpuDetect", "Platforms" subdirs all contain a "." or no hyphen,
	     so the regex leaves them alone. -->
	<Target Name="RemoveWinUIMuiLocaleFolders"
	        AfterTargets="Build;Publish"
	        Condition="'$([MSBuild]::GetTargetPlatformIdentifier($(TargetFramework)))' == 'windows'">
		<ItemGroup>
			<_WinUILocaleDir Include="$([System.IO.Directory]::GetDirectories('$(OutDir)'))" />
		</ItemGroup>
		<RemoveDir Directories="@(_WinUILocaleDir)"
		           Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(Filename)', '^[a-zA-Z]{2,3}(-[A-Za-z0-9]+)+$')) And '%(Filename)' != 'en-us'" />
	</Target>

</Project>
