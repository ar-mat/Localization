<Project>

	<PropertyGroup>

		<Company>Armat</Company>
		<Product>Armat Localization</Product>
		<Authors>Ara Petrosyan</Authors>

		<_ArmatLocalizationVersion>2.2.0</_ArmatLocalizationVersion>
		<Version>$(_ArmatLocalizationVersion)</Version>
		<AssemblyVersion>$(_ArmatLocalizationVersion).0</AssemblyVersion>
		<FileVersion>$(_ArmatLocalizationVersion).0</FileVersion>
		<_NugetVersionPostfix>-beta</_NugetVersionPostfix>

		<_DotNetVersion>net10.0</_DotNetVersion>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>

		<_BinDir>$(SolutionDir)\..\..\bin\$(Configuration)</_BinDir>
		<OutputPath>$(_BinDir)\</OutputPath>
		<IntermediateOutputPath>$(OutputPath)\obj\$(MSBuildProjectName)\</IntermediateOutputPath>

		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<EnforceCodeStyleInBuild>True</EnforceCodeStyleInBuild>

		<_ProjectWebpageUrl>http://armat.am/products/localization</_ProjectWebpageUrl>
		<_ProjectLicenseType>MIT</_ProjectLicenseType>
		<_SourceCoreRepositoryRootUrl>https://github.com/ar-mat/Localization</_SourceCoreRepositoryRootUrl>
		<_SourceCoreRepositoryType>git</_SourceCoreRepositoryType>

	</PropertyGroup>

</Project>
