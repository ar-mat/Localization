<Project Sdk="Microsoft.NET.Sdk">

	<!-- Import common definitions -->
	<Import Project="../Localization.Import.csproj" />

	<PropertyGroup>

		<AssemblyName>armat.localization.maui</AssemblyName>
		<RootNamespace>Armat.Localization.Maui</RootNamespace>

		<OutputType>Library</OutputType>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<TargetFrameworks>$(_DotNetVersion)-android</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);$(_DotNetVersion)-ios;$(_DotNetVersion)-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);$(_DotNetVersion)-windows10.0.19041.0</TargetFrameworks>

		<OutputPath>..\..\bin\$(Configuration)\Maui\$(TargetFramework)</OutputPath>
		<IntermediateOutputPath>..\..\bin\$(Configuration)\obj\Maui\$(TargetFramework)\$(AssemblyName)</IntermediateOutputPath>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">21.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- Pin TargetPlatformVersion so the published NuGet package's lib folders are deterministic
		     (e.g. lib/net10.0-ios26.0/) instead of inheriting whatever platform SDK the packing
		     machine happens to have installed at pack time. Without these pins, an SDK upgrade on
		     the packer's machine silently ratchets the package's lib folders to a newer version
		     and locks out every consumer that hasn't installed the matching SDK
		     (NU1202: package supports net10.0-iosXX.X, consumer is on net10.0-iosYY.Y, YY < XX).
		     Lower these to broaden consumer compatibility once the matching workload manifests
		     are installed via `dotnet workload install` with an explicit older version. -->
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">26.0</TargetPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">26.0</TargetPlatformVersion>
		<TargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">36.0</TargetPlatformVersion>

		<!-- Suppress per-locale subdirectories (cs/, de/, es/, ja/, ...) in the output. These are
		     Microsoft.Maui.Controls.resources.dll satellites for the framework's own UI strings
		     and are unrelated to this library's localization files. `en` is the neutral resources
		     language and is embedded in the main assembly, so this effectively yields no
		     satellite folders. -->
		<SatelliteResourceLanguages>en</SatelliteResourceLanguages>

		<GeneratePackageOnBuild>False</GeneratePackageOnBuild>
		<Title>Armat Localization Maui Module</Title>
		<Description>C# class library for developing localizable applications. Armat.Localization.Maui module contains LocalizableResourceDictionary to be used for MAUI applications.</Description>
		<PackageIcon>AppIcon.png</PackageIcon>
		<PackageTags>Localization Translation MultiLingual Language Culture MAUI</PackageTags>
		<PackageReadmeFile>Readme.md</PackageReadmeFile>
		<PackageReleaseNotes>$(_ReleaseNotes)</PackageReleaseNotes>

		<PackageVersion>$(_ArmatLocalizationVersion)$(_NugetVersionPostfix)</PackageVersion>
		<PackageProjectUrl>$(_ProjectWebpageUrl)</PackageProjectUrl>
		<RepositoryUrl>$(_SourceCoreRepositoryRootUrl)</RepositoryUrl>
		<RepositoryType>$(_SourceCoreRepositoryType)</RepositoryType>
		<PackageLicenseExpression>$(_ProjectLicenseType)</PackageLicenseExpression>

	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.7" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />

		<PackageReference Condition="'$(Configuration)' != 'Debug'" Include="armat.localization.core" Version="$(_ArmatLocalizationVersion)$(_NugetVersionPostfix)" />
		<ProjectReference Condition="'$(Configuration)' == 'Debug'" Include="..\Localization.Core\Localization.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="AppIcon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="Readme.md">
	    <PackagePath>\</PackagePath>
	    <Pack>True</Pack>
	  </None>
	</ItemGroup>

</Project>
